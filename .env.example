# ================================
# Configuración de la aplicación
# ================================
APP_HOST=evidencias.lan
ENVIRONMENT=development

# ================================
# Base de datos
# ================================
DB_NAME=evidencias
DB_OWNER=evidencias_owner
DB_OWNER_PASSWORD=cambiar_esto_en_produccion
DB_APP_USER=evidencias_app
DB_APP_PASSWORD=cambiar_esto_en_produccion
DATABASE_URL=postgresql+psycopg://evidencias_app:cambiar_esto_en_produccion@db:5432/evidencias

# ================================
# Microsoft Entra ID (Azure AD)
# ================================
# Tenant ID de tu organización
ENTRA_TENANT_ID=
# Client ID de la aplicación registrada en Azure AD
ENTRA_CLIENT_ID=

# ================================
# Scope personalizado de la API
# ================================
# Formato: api://<ENTRA_CLIENT_ID>/access
# Debe coincidir con el scope registrado en "Expose an API" en Azure AD
API_SCOPE=

# ================================
# Microsoft Graph / SharePoint
# ================================
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
SP_SITE_ID=
SP_DRIVE_ID=

# ================================
# CORS (solo desarrollo)
# ================================
# Orígenes permitidos separados por coma
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ================================
# Autenticación
# ================================
# ⚠️ IMPORTANTE: Solo usar true en desarrollo local
# En producción DEBE ser false
AUTH_DISABLED=false
