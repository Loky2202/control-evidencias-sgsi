# Configuración de la aplicación
APP_HOST=evidencias.lan
ENVIRONMENT=development

# Base de datos
DB_NAME=evidencias
DB_OWNER=evidencias_owner
DB_OWNER_PASSWORD=cambiar_esto_en_produccion
DB_APP_USER=evidencias_app
DB_APP_PASSWORD=cambiar_esto_en_produccion
DATABASE_URL=postgresql+psycopg://evidencias_app:cambiar_esto_en_produccion@db:5432/evidencias

# Microsoft Entra ID (Azure AD)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=

# Microsoft Graph / SharePoint
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
SP_SITE_ID=
SP_DRIVE_ID=

# Autenticación (solo desarrollo)
# IMPORTANTE: Dejar en false para producción. Solo usar true en desarrollo local.
AUTH_DISABLED=false
